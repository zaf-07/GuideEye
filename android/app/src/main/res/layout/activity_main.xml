<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/guide_bg" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GUIDEBAND · ACCESSIBILITY LAYER" android:textColor="@color/guide_lime" android:textSize="12sp" android:letterSpacing="0.12" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Your phone,&#10;without the screen." android:textColor="@color/guide_text" android:textSize="45sp" android:textStyle="bold" />
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="18dp" android:background="@color/guide_panel" android:text="Assistant is stopped" android:textColor="@color/guide_text" android:textSize="17sp" android:accessibilityLiveRegion="polite" />
<Button android:id="@+id/startAssistant" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="30dp" android:text="Start voice assistant" android:textAllCaps="false" android:textSize="18sp" />
<Button android:id="@+id/stopAssistant" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="Stop listening" android:textAllCaps="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="38dp" android:text="SETUP" android:textColor="@color/guide_lime" android:textSize="12sp" android:letterSpacing="0.12" android:textStyle="bold" />
<Button android:id="@+id/chooseAssistant" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="1 · Choose GuideEye as assistant" android:textAllCaps="false" />
<Button android:id="@+id/enableAccessibility" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="2 · Enable phone control" android:textAllCaps="false" />
<Button android:id="@+id/grantNotifications" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="3 · Allow notifications" android:textAllCaps="false" />
<Button android:id="@+id/bridgeButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="Open Bridge" android:textAllCaps="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:padding="20dp" android:background="@color/guide_panel" android:text="Try saying:&#10;&#10;“Guide, open YouTube”&#10;“Guide, set a timer for ten minutes”&#10;“Guide, search for coffee nearby”&#10;“Guide, let’s walk to Safeway”&#10;“Guide, call Alex”&#10;“Guide, stop listening”" android:textColor="@color/guide_text" android:textSize="17sp" android:lineSpacingExtra="6dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Audio input: GuideEye uses the phone microphone, or the Vexo Open bridge streams band 20’s microphone through its official USB/BLE contract. A short phone vibration confirms each accepted command. The Vexo Open hardware has no vibration motor, so the Android phone is the tactile channel. GuideEye always shows a notification while listening." android:textColor="@color/guide_muted" android:textSize="14sp" />
</LinearLayout></ScrollView>
