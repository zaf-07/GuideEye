{
  "name": "guideeye",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible AI companion for vision, hearing and nearby conversations",
  "workspaces": [
    "apps/mobile"
  ],
  "desktopName": "GuideEye",
  "author": {
    "name": "GuideEye Team",
    "email": "78542749+k1lst1x@users.noreply.github.com"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "web": "npx serve web",
    "test": "python3 -m unittest discover -s backend/tests -v",
    "mobile": "npm --workspace apps/mobile run start",
    "mobile:ios": "npm --workspace apps/mobile run ios",
    "mobile:typecheck": "npm --workspace apps/mobile run typecheck",
    "mobile:test": "npm --workspace apps/mobile run test:unit",
    "mobile:doctor": "npm --workspace apps/mobile run doctor",
    "desktop": "electron .",
    "dist:desktop": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "serve": "^14.2.5"
  },
  "build": {
    "appId": "ai.guideband.desktop",
    "productName": "GuideEye",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "web/**/*", "build/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.lifestyle", "icon": "build/icon.icns" },
    "win": { "target": ["nsis", "portable"] },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "GuideEye Team <78542749+k1lst1x@users.noreply.github.com>",
      "executableName": "guideband",
      "syncDesktopName": true
    }
  }
}
