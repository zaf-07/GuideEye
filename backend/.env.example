# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional fallback provider, tried when Gemini fails.
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Order in which cloud providers are tried.
# VISION_PROVIDERS=gemini,minimax,groq

# Local detector.
# YOLO_ENABLED=true
# YOLO_MODEL=backend/models/yolo11n.pt
# YOLO_DEVICE=cuda:0
# YOLO_MIN_CONFIDENCE=0.35

# Payments: only Stripe test keys (sk_test_... or rk_test_...) are accepted. Empty = simulated.
# STRIPE_SECRET_KEY=

# Natural voice (optional). Without it the browser voice is used.
# MiniMax is preferred when configured; ElevenLabs and Deepgram remain fallbacks.
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3.1-Flash
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_VOICE_ID=English_expressive_narrator
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# WhatsApp delivery without a manual Send tap (optional, Twilio).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# Windows only, opt-in: press Send in WhatsApp Desktop on this computer after a spoken yes.
# WHATSAPP_DESKTOP_SEND=true
# WHATSAPP_SEND_DELAY_MS=4000

# Speech-to-text for a chosen microphone such as the Vexo bracelet (Deepgram Nova-3).
# Set this only in your own ignored .env or shell; never commit a real key.
# DEEPGRAM_API_KEY=

# Which voice to try first when several keys are set: elevenlabs, deepgram or minimax.
# SPEECH_VOICE=elevenlabs

# Long-term memory (optional). Without a key, memory stays local to this machine:
# SQLite plus the on-device relationship graph. With one, every text note is also
# mirrored to Supermemory, which links entities across notes and devices, and
# recall asks it alongside the local graph. Frames, audio and GPS are never sent.
# SUPERMEMORY_API_KEY=
# One namespace per wearer, so several users on one key stay separate.
# SUPERMEMORY_NAMESPACE=guideband-user
# SUPERMEMORY_BASE_URL=https://api.supermemory.ai
